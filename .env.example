# KiraEnterprise v5.5 - Environment Variables
# Copy this file to .env and fill in values

# Application
VITE_APP_NAME=KiraEnterprise
VITE_APP_VERSION=5.5.0
VITE_API_URL=http://localhost:8787

# Environment (development, staging, production)
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_EINVOICE=true
VITE_ENABLE_ZAKAT=true
VITE_ENABLE_YEAREND=true

# Timezone
VITE_DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# Currency
VITE_DEFAULT_CURRENCY=MYR

# Platform
VITE_PLATFORM_ID=134deb69-2609-4b84-8e5c-079aa8d9ba3a
